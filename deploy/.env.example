# PoPo 部署配置：复制为 .env 后填写；.env 不入仓（已在 .gitignore）。
# 密钥用长随机十六进制：python -c "import secrets; print(secrets.token_hex(24))"

POPO_API_KEY=change-me-long-random-hex
POPO_IMAGE=your-gb10-vllm-image:tag   # 任意 GB10(arm64) vLLM 镜像（含 vllm serve CLI 与 python3）
POPO_HOME=/home/<your-user>
POPO_MODEL_DIR=/home/<your-user>/models/MinerU-Popo
POPO_WEIGHTS_REVISION=af75342
POPO_HF_ENDPOINT=https://hf-mirror.com   # hf 权重下载源（透传 HF_ENDPOINT）
POPO_USE_MODELSCOPE=0                    # 1=用 modelscope CLI 从 ModelScope 下载权重（需 pip install modelscope）

POPO_PROXY_PORT=8008
# 官方 generation_config 采样默认；客户端显式传参时被尊重（setdefault 语义）
POPO_PROXY_TEMPERATURE=0.7
POPO_PROXY_TOP_P=0.8
POPO_PROXY_TOP_K=20
